        </article>
        <article>
          <p class="number">02</p>
          <h2>GitHub</h2>
          <p>Stores website source code and change history.</p>
        </article>
        <article>
          <p class="number">03</p>
          <h2>Cloudflare Pages</h2>
          <p>Automated web publishing triggered by GitHub updates</p>
        </article>
      </section>

      <footer>
        <span>A Static Website</span>
        <a href="https://developers.cloudflare.com/pages/">Cloudflare Pages Documentation↗</a>
      </footer>
    </main>
